{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sauva Configuration Schema",
  "description": "Schema for sauva's TOML configuration file.",
  "type": "object",
  "properties": {
    "color": {
      "$ref": "#/definitions/colorTheme"
    },
    "glyph_preview": {
      "$ref": "#/definitions/glyphPreviewSettings"
    },
    "ui": {
      "$ref": "#/definitions/uiSettings"
    },
    "keybindings": {
      "$ref": "#/definitions/keybindings"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "color": {
      "description": "A canonical ANSI color name, an RGB value in #RRGGBB form, or an indexed color from 0 through 255.",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "reset",
            "black",
            "red",
            "green",
            "yellow",
            "blue",
            "magenta",
            "cyan",
            "gray",
            "darkgray",
            "dark-gray",
            "light-red",
            "light-green",
            "light-yellow",
            "light-blue",
            "light-magenta",
            "light-cyan",
            "white"
          ]
        },
        {
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        {
          "pattern": "^(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$"
        }
      ]
    },
    "rgbaColor": {
      "description": "An RGB or RGBA color in #RRGGBB or #RRGGBBAA form.",
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
    },
    "glyphPreviewSettings": {
      "description": "Fonts and colors used to render glyph preview images. Omitted properties keep their built-in defaults.",
      "type": "object",
      "properties": {
        "font_families": {
          "description": "Preferred normal font families in fallback order. Missing families and unsupported glyphs are skipped.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "default": []
        },
        "emoji_font_families": {
          "description": "Explicit emoji font families tried after the system default text face and before platform fallback.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "default": []
        },
        "fg": {
          "allOf": [
            {
              "$ref": "#/definitions/rgbaColor"
            }
          ],
          "default": "#f5f7fa"
        },
        "bg": {
          "allOf": [
            {
              "$ref": "#/definitions/rgbaColor"
            }
          ],
          "default": "#00000000"
        }
      },
      "additionalProperties": false
    },
    "selectionColors": {
      "type": "object",
      "properties": {
        "fg": {
          "allOf": [
            {
              "$ref": "#/definitions/color"
            }
          ],
          "default": "black"
        },
        "bg": {
          "allOf": [
            {
              "$ref": "#/definitions/color"
            }
          ],
          "default": "cyan"
        }
      },
      "additionalProperties": false
    },
    "differenceColors": {
      "description": "Changed normalization spans, separate from the selection colors. Underlining also identifies these spans.",
      "type": "object",
      "properties": {
        "fg": {
          "allOf": [{ "$ref": "#/definitions/color" }],
          "default": "black"
        },
        "bg": {
          "allOf": [{ "$ref": "#/definitions/color" }],
          "default": "yellow"
        }
      },
      "additionalProperties": false
    },
    "statusColors": {
      "type": "object",
      "properties": {
        "info": {
          "allOf": [
            {
              "$ref": "#/definitions/color"
            }
          ],
          "default": "green"
        },
        "warning": {
          "allOf": [
            {
              "$ref": "#/definitions/color"
            }
          ],
          "default": "yellow"
        }
      },
      "additionalProperties": false
    },
    "colorTheme": {
      "description": "Colors used by the application UI. Omitted properties keep their built-in defaults.",
      "type": "object",
      "properties": {
        "fg": {
          "allOf": [
            {
              "$ref": "#/definitions/color"
            }
          ],
          "default": "reset"
        },
        "bg": {
          "allOf": [
            {
              "$ref": "#/definitions/color"
            }
          ],
          "default": "reset"
        },
        "muted": {
          "allOf": [
            {
              "$ref": "#/definitions/color"
            }
          ],
          "default": "darkgray"
        },
        "accent": {
          "allOf": [
            {
              "$ref": "#/definitions/color"
            }
          ],
          "default": "cyan"
        },
        "heading": {
          "allOf": [
            {
              "$ref": "#/definitions/color"
            }
          ],
          "default": "blue"
        },
        "border": {
          "allOf": [
            {
              "$ref": "#/definitions/color"
            }
          ],
          "default": "darkgray"
        },
        "match": {
          "allOf": [
            {
              "$ref": "#/definitions/color"
            }
          ],
          "default": "yellow"
        },
        "key": {
          "allOf": [
            {
              "$ref": "#/definitions/color"
            }
          ],
          "default": "yellow"
        },
        "link": {
          "allOf": [
            {
              "$ref": "#/definitions/color"
            }
          ],
          "default": "blue"
        },
        "selection": {
          "$ref": "#/definitions/selectionColors"
        },
        "difference": {
          "$ref": "#/definitions/differenceColors"
        },
        "status": {
          "$ref": "#/definitions/statusColors"
        }
      },
      "additionalProperties": false
    },
    "uiSettings": {
      "description": "Non-color presentation settings. Omitted properties keep their built-in defaults.",
      "type": "object",
      "properties": {
        "input_cursor": {
          "description": "Cursor shown in the search input. Text mode inserts a visible one-cell character at the input position; runtime validation checks its terminal width.",
          "oneOf": [
            {
              "const": "native"
            },
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
                }
              },
              "required": ["text"],
              "additionalProperties": false
            }
          ],
          "default": "native"
        }
      },
      "additionalProperties": false
    },
    "key": {
      "description": "A single non-whitespace character, a named key, or a unique combination of ctrl, alt, and shift followed by one character.",
      "type": "string",
      "oneOf": [
        {
          "enum": [
            "space",
            "enter",
            "esc",
            "tab",
            "backspace",
            "delete",
            "left",
            "right",
            "up",
            "down",
            "home",
            "end",
            "pageup",
            "pagedown",
            "f1",
            "f2",
            "f3",
            "f4",
            "f5",
            "f6",
            "f7",
            "f8",
            "f9",
            "f10",
            "f11",
            "f12"
          ]
        },
        {
          "pattern": "^[^\\s\\u0000-\\u001F\\u007F]$"
        },
        {
          "pattern": "^(?:ctrl|alt|shift|ctrl-alt|ctrl-shift|alt-ctrl|alt-shift|shift-ctrl|shift-alt|ctrl-alt-shift|ctrl-shift-alt|alt-ctrl-shift|alt-shift-ctrl|shift-ctrl-alt|shift-alt-ctrl)-[^\\s\\u0000-\\u001F\\u007FA-Z]$"
        }
      ]
    },
    "keyArray": {
      "description": "Keys replacing the built-in binding for one command. An empty array disables that command in this context.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/key"
      },
      "uniqueItems": true
    },
    "globalKeybindings": {
      "type": "object",
      "properties": {
        "quit": {
          "$ref": "#/definitions/keyArray"
        },
        "help": {
